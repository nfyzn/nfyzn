# Порт сервера
PORT=3000

# Режим работы (development/production)
NODE_ENV=development

# База данных PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movielist_db
DB_USER=movielist_user
DB_PASSWORD=your_secure_password_here

# JWT секреты (смените на случайные строки!)
# Генерация: openssl rand -base64 32
JWT_ACCESS_SECRET=your_access_token_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_token_secret_min_32_chars

# Время жизни токенов
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Админ панель
ADMIN_EMAIL=admin@movielist.app
ADMIN_PASSWORD=change_this_password_immediately

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Лимиты для синхронизации
SYNC_BATCH_SIZE=100
SYNC_MAX_CHANGES=1000

# Логирование
LOG_LEVEL=info
LOG_FILE=logs/app.log

# CORS (разрешённые домены)
CORS_ORIGIN=*
