# Пример файла .env
# Скопируйте этот файл в .env и заполните реальными значениями

# Окружение
NODE_ENV=production
PORT=3000

# База данных
# Пароль будет сгенерирован скриптом setup_server.sh
DATABASE_URL=postgresql://movielist_user:PASSWORD@localhost:5432/movielist

# JWT секреты (сгенерируйте случайные строки)
# openssl rand -base64 64 | tr -dc 'a-zA-Z0-9' | head -c 64
JWT_SECRET=your_jwt_secret_key_min_64_characters_long_random_string
JWT_EXPIRES_IN=30d
REFRESH_TOKEN_SECRET=your_refresh_token_secret_min_64_characters_random

# Redis
REDIS_URL=redis://localhost:6379

# SMTP (для восстановления пароля - опционально)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# URL приложения
API_URL=http://95.81.121.164:3000
FRONTEND_URL=http://95.81.121.164

# Лимиты
MAX_FILE_SIZE=10485760
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# Логирование
LOG_LEVEL=info
